{
  "name": "careerly-job-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Careerly job portal with a SQLite local-development database and optional MySQL server",
  "main": "server.js",
  "scripts": {
    "start": "node local-server.js",
    "dev": "node --watch local-server.js",
    "db:inspect": "node database/inspect-sqlite.js",
    "start:mysql": "node server.js",
    "check": "node --check server.js",
    "setup:mysql": "powershell -ExecutionPolicy Bypass -File ./configure-mysql.ps1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3"
  }
}
